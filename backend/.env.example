# Copy to .env and edit. Never commit the real file.

APP_NAME=RainWise
ENVIRONMENT=development
DEBUG=true

# Local zero-setup default. Use PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg://rainwise:rainwise_dev_only@localhost:5432/rainwise
DATABASE_URL=sqlite:///./rainwise.db
AUTO_CREATE_TABLES=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-before-deploying
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
RESET_TOKEN_MINUTES=30

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOGIN_ATTEMPTS_PER_MINUTE=10
REGISTER_ATTEMPTS_PER_HOUR=5

# Optional. Without a key the AI concept card stays disabled.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TIMEOUT_SECONDS=90
